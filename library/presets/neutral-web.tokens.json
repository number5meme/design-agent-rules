{
  "name": "neutral-web",
  "format": "design-agent-preset-v2",
  "description": "Independently organized neutral UI starting point: regular spacing, responsive ranges set by content column width, solid surfaces, and common controls. Not a replication of a specific brand; a custom recipe that does not claim DTCG compatibility.",
  "colors": {
    "primary": "#245da8",
    "primary-hover": "#1d4d8c",
    "primary-on-dark": "#a8cdff",
    "on-primary": "#ffffff",
    "ink": "#202630",
    "text-secondary": "#596473",
    "text-on-dark": "#f3f6fa",
    "text-secondary-on-dark": "#bdcad9",
    "canvas": "#ffffff",
    "surface-subtle": "#f0f4f8",
    "surface-raised": "#f7f9fc",
    "surface-dark-base": "#131b25",
    "surface-dark-panel": "#202c3b",
    "surface-dark-raised": "#2d3d50",
    "control-border": "#737d8c",
    "control-border-dark": "#a1afc0",
    "divider": "#d8e0ea",
    "focus-light": "#7040a0",
    "focus-dark": "#e1c4ff",
    "selected-light": "#245f49",
    "selected-dark": "#a1e0be",
    "selected-surface-light": "#e8f3ed",
    "selected-surface-dark": "#263c34"
  },
  "typography": {
    "display": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "48px",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": 0
    },
    "heading": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "36px",
      "fontWeight": 600,
      "lineHeight": 1.25,
      "letterSpacing": 0
    },
    "subheading": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "28px",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": 0
    },
    "lead": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "20px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": 0
    },
    "body": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": 0
    },
    "label": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 600,
      "lineHeight": 1.5,
      "letterSpacing": 0
    },
    "caption": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": 0
    },
    "fine-print": {
      "fontFamily": "system-ui, sans-serif",
      "fontSize": "12px",
      "fontWeight": 400,
      "lineHeight": 1.5,
      "letterSpacing": 0
    }
  },
  "rounded": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "48px",
    "section": "64px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-primary}",
      "typography": "{typography.label}",
      "rounded": "{rounded.md}",
      "padding": "12px 16px",
      "minHeight": "48px"
    },
    "button-primary-hover": {
      "extends": "button-primary",
      "backgroundColor": "{colors.primary-hover}"
    },
    "button-primary-focus": {
      "extends": "button-primary",
      "outline": "2px solid {colors.focus-light}",
      "outlineOffset": "3px"
    },
    "button-primary-focus-on-dark": {
      "extends": "button-primary",
      "outline": "2px solid {colors.focus-dark}",
      "outlineOffset": "3px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.ink}",
      "border": "1px solid {colors.control-border}",
      "rounded": "{rounded.md}",
      "padding": "12px 16px",
      "minHeight": "48px"
    },
    "button-icon": {
      "backgroundColor": "{colors.surface-subtle}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.md}",
      "size": "48px"
    },
    "text-link": {
      "textColor": "{colors.primary}",
      "textDecoration": "underline"
    },
    "text-link-on-dark": {
      "textColor": "{colors.primary-on-dark}",
      "textDecoration": "underline"
    },
    "panel": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.lg}",
      "padding": "{spacing.lg}"
    },
    "panel-on-dark": {
      "extends": "panel",
      "backgroundColor": "{colors.surface-dark-panel}",
      "textColor": "{colors.text-on-dark}"
    },
    "option": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.ink}",
      "border": "1px solid {colors.control-border}",
      "rounded": "{rounded.sm}",
      "padding": "12px 16px",
      "minHeight": "48px"
    },
    "option-selected": {
      "extends": "option",
      "backgroundColor": "{colors.selected-surface-light}",
      "border": "2px solid {colors.selected-light}",
      "selectionIndicator": "check",
      "indicatorColor": "{colors.selected-light}"
    },
    "option-on-dark": {
      "extends": "option",
      "backgroundColor": "{colors.surface-dark-panel}",
      "textColor": "{colors.text-on-dark}",
      "border": "1px solid {colors.control-border-dark}"
    },
    "option-selected-on-dark": {
      "extends": "option-on-dark",
      "backgroundColor": "{colors.selected-surface-dark}",
      "border": "2px solid {colors.selected-dark}",
      "selectionIndicator": "check",
      "indicatorColor": "{colors.selected-dark}"
    },
    "option-selected-focus": {
      "extends": "option-selected",
      "outline": "2px solid {colors.focus-light}",
      "outlineOffset": "3px"
    },
    "option-selected-focus-on-dark": {
      "extends": "option-selected-on-dark",
      "outline": "2px solid {colors.focus-dark}",
      "outlineOffset": "3px"
    },
    "input": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.ink}",
      "typography": "{typography.body}",
      "rounded": "{rounded.sm}",
      "padding": "12px 16px",
      "minHeight": "48px",
      "border": "1px solid {colors.control-border}"
    },
    "input-on-dark": {
      "extends": "input",
      "backgroundColor": "{colors.surface-dark-panel}",
      "textColor": "{colors.text-on-dark}",
      "border": "1px solid {colors.control-border-dark}"
    }
  },
  "focus": {
    "light": {
      "outline": "2px solid {colors.focus-light}",
      "outlineOffset": "3px"
    },
    "dark": {
      "outline": "2px solid {colors.focus-dark}",
      "outlineOffset": "3px"
    },
    "usage": "When any interactive component receives focus, including inputs, options, and links, apply the focus ring of the theme matching its surface; selection marks stay visible, and the focus ring does not replace the selected border."
  },
  "effects": {
    "overlay-shadow": "0 8px 24px rgba(15, 25, 40, 0.18)",
    "backdropFilter": "none"
  },
  "layout": {
    "text-max-width": "68ch",
    "grid-gap": "24px",
    "inline-padding": "16px",
    "card-min-width": "280px",
    "content-max-width": "1200px"
  },
  "responsive": [
    {
      "minWidth": 0,
      "columns": 1,
      "inlinePadding": "16px"
    },
    {
      "minWidth": 640,
      "columns": 2,
      "inlinePadding": "24px"
    },
    {
      "minWidth": 960,
      "columns": 3,
      "inlinePadding": "24px"
    },
    {
      "minWidth": 1280,
      "columns": 4,
      "inlinePadding": "32px"
    }
  ],
  "responsiveRationale": "Column capacity is checked with a 280px card minimum width, 24px gap, and inline padding; column counts are starting points, and drop a column earlier when content is wider. Text wraps naturally and does not inherit old site navigation breakpoints. content-max-width means the content width excluding outer padding.",
  "statusSource": "status-pairs.json",
  "statusThemes": [
    "light",
    "dark"
  ],
  "contrastPairs": [
    {
      "foreground": "{colors.ink}",
      "background": "{colors.canvas}",
      "minimum": 4.5
    },
